{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/web", "dev", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "mobile",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/mobile",
        "start",
        "--",
        "--dev-client",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "mobile-go",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/mobile",
        "start",
        "--",
        "--go",
        "--port",
        "8082"
      ],
      "port": 8082
    }
  ]
}
