# Copy to .env. EXPO_PUBLIC_ values are bundled into the app, so only the
# publishable key belongs here, never the secret key.
# On a phone, use this computer's LAN address, not localhost.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: usernames become <username>@<domain>. Defaults to quiver.local.
EXPO_PUBLIC_LOGIN_USERNAME_DOMAIN=quiver.local
