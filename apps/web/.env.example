# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Use the publishable key, never the secret/service_role key: NEXT_PUBLIC_
# values are shipped to the browser and baked into the desktop build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Usernames sign in as <username>@<this domain>. Create each Supabase user
# with that email (e.g. coach@quiver.local). Defaults to quiver.local.
NEXT_PUBLIC_LOGIN_USERNAME_DOMAIN=quiver.local
